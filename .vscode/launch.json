{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Datsumi Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/extension"],
      "outFiles": ["${workspaceFolder}/apps/extension/dist/**/*.cjs"]
    }
  ]
}
