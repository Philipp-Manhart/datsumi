{
  "name": "datsumi",
  "displayName": "Datsumi — Database Explorer",
  "version": "0.3.0",
  "private": true,
  "description": "A modern, unified database client for VS Code. Explore, query, and manage SQL and NoSQL databases without leaving your editor.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "database",
    "nosql",
    "postgresql",
    "sql",
    "sqlite"
  ],
  "homepage": "https://github.com/Philipp-Manhart/datsumi#readme",
  "bugs": {
    "url": "https://github.com/Philipp-Manhart/datsumi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Philipp-Manhart/datsumi.git",
    "directory": "apps/extension"
  },
  "publisher": "philipp-manhart",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "bun esbuild.mjs",
    "clean": "rm -rf dist",
    "dev": "bun esbuild.mjs --watch",
    "package": "vsce package --no-dependencies --pre-release",
    "test:integration": "bun run build && node test/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "bun run build"
  },
  "dependencies": {
    "@datsumi/core": "workspace:*",
    "@datsumi/driver-api": "workspace:*",
    "@datsumi/driver-duckdb": "workspace:*",
    "@datsumi/driver-nosql": "workspace:*",
    "@datsumi/driver-sql": "workspace:*",
    "@datsumi/driver-sqlite": "workspace:*",
    "@datsumi/protocol": "workspace:*",
    "csv-parse": "^7.0.3",
    "detect-libc": "2.1.2",
    "sql-formatter": "^15.9.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ssh2": "1.15.6",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "datsumi",
          "title": "Datsumi",
          "icon": "./resources/datsumi-activity.svg"
        }
      ],
      "panel": [
        {
          "id": "datsumi-resultsPanel",
          "title": "Query Results",
          "icon": "./resources/datsumi-activity.svg"
        }
      ]
    },
    "views": {
      "datsumi": [
        {
          "id": "datsumi.connections",
          "name": "Datsumi Connections",
          "icon": "./resources/datsumi-activity.svg"
        },
        {
          "id": "datsumi.history",
          "name": "Query History",
          "visibility": "collapsed",
          "icon": "./resources/datsumi-activity.svg"
        }
      ],
      "datsumi-resultsPanel": [
        {
          "type": "webview",
          "id": "datsumi.queryResults",
          "name": "Query Results",
          "icon": "./resources/datsumi-activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "datsumi.openSqlite",
        "title": "Open SQLite Database",
        "category": "Datsumi",
        "icon": "$(add)"
      },
      {
        "command": "datsumi.refreshConnections",
        "title": "Refresh Connections",
        "category": "Datsumi",
        "icon": "$(refresh)"
      },
      {
        "command": "datsumi.newQuery",
        "title": "New Query",
        "category": "Datsumi",
        "icon": "$(new-file)"
      },
      {
        "command": "datsumi.runQuery",
        "title": "Run Query",
        "category": "Datsumi",
        "icon": "$(play)"
      },
      {
        "command": "datsumi.selectConnection",
        "title": "Use Connection",
        "category": "Datsumi",
        "icon": "$(database)"
      },
      {
        "command": "datsumi.openTable",
        "title": "Open Table",
        "category": "Datsumi",
        "icon": "$(table)"
      },
      {
        "command": "datsumi.disconnect",
        "title": "Disconnect",
        "category": "Datsumi",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "datsumi.removeConnection",
        "title": "Remove Connection…",
        "category": "Datsumi",
        "icon": "$(trash)"
      },
      {
        "command": "datsumi.formatSql",
        "title": "Format SQL",
        "category": "Datsumi",
        "icon": "$(code)"
      },
      {
        "command": "datsumi.renameResult",
        "title": "Rename Tab…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.closeResult",
        "title": "Close Tab",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.showRelationships",
        "title": "View Relationships",
        "category": "Datsumi",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "datsumi.showHistory",
        "title": "Query History",
        "category": "Datsumi",
        "icon": "$(history)"
      },
      {
        "command": "datsumi.clearHistory",
        "title": "Clear Query History",
        "category": "Datsumi",
        "icon": "$(clear-all)"
      },
      {
        "command": "datsumi.explainQuery",
        "title": "Explain Query",
        "category": "Datsumi",
        "icon": "$(list-tree)"
      },
      {
        "command": "datsumi.configureSqlEditor",
        "title": "SQL Editor Settings…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.addConnection",
        "title": "Add Database Connection",
        "category": "Datsumi",
        "icon": "$(add)"
      },
      {
        "command": "datsumi.manageDrivers",
        "title": "Manage Database Support",
        "category": "Datsumi",
        "icon": "$(extensions)"
      },
      {
        "command": "datsumi.forgetCredentials",
        "title": "Forget Credentials…",
        "category": "Datsumi",
        "icon": "$(lock)"
      },
      {
        "command": "datsumi.changeCredentials",
        "title": "Edit Credentials…",
        "category": "Datsumi",
        "icon": "$(key)"
      },
      {
        "command": "datsumi.stageJsonValue",
        "title": "Stage JSON Value",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.transaction",
        "title": "Commit / Rollback Transaction…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.setEnvironment",
        "title": "Set Environment…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.quickOpen",
        "title": "Go to Database Object…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.filterObjects",
        "title": "Filter Objects…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.toggleFavorite",
        "title": "Toggle Favorite",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.toggleHistory",
        "title": "Query History Settings…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.openDuckdb",
        "title": "Open DuckDB Database",
        "category": "Datsumi",
        "icon": "$(database)"
      },
      {
        "command": "datsumi.searchHistory",
        "title": "Search Query History…",
        "category": "Datsumi",
        "icon": "$(search)"
      },
      {
        "command": "datsumi.openHistory",
        "title": "Open Query",
        "category": "Datsumi",
        "icon": "$(go-to-file)"
      },
      {
        "command": "datsumi.copyHistory",
        "title": "Copy Query",
        "category": "Datsumi",
        "icon": "$(copy)"
      },
      {
        "command": "datsumi.favoriteHistory",
        "title": "Toggle Favorite",
        "category": "Datsumi",
        "icon": "$(star-empty)"
      },
      {
        "command": "datsumi.deleteHistory",
        "title": "Delete History Entry",
        "category": "Datsumi",
        "icon": "$(trash)"
      },
      {
        "command": "datsumi.runQueryNewResult",
        "title": "Run Query in New Result",
        "category": "Datsumi",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "datsumi.pinResult",
        "title": "Pin / Unpin Result",
        "category": "Datsumi",
        "icon": "$(pin)"
      },
      {
        "command": "datsumi.forgetSshHostKey",
        "title": "Forget SSH Host Key",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.backupSqlite",
        "title": "Back Up SQLite Database…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.editConnection",
        "title": "Edit Connection…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.duplicateConnection",
        "title": "Duplicate Connection…",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.copyDiagnostics",
        "title": "Copy Redacted Connection Diagnostics",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.clearDrafts",
        "title": "Clear Saved Edit Drafts",
        "category": "Datsumi"
      },
      {
        "command": "datsumi.gettingStarted",
        "title": "Getting Started",
        "category": "Datsumi",
        "icon": "$(book)"
      },
      {
        "command": "datsumi.help",
        "title": "Help and Privacy…",
        "category": "Datsumi",
        "icon": "$(question)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "datsumi.refreshConnections",
          "when": "view == datsumi.connections",
          "group": "navigation@2"
        },
        {
          "command": "datsumi.addConnection",
          "when": "view == datsumi.connections",
          "group": "navigation@0"
        },
        {
          "command": "datsumi.showHistory",
          "when": "view == datsumi.connections",
          "group": "navigation@1"
        },
        {
          "command": "datsumi.searchHistory",
          "when": "view == datsumi.history",
          "group": "navigation@1"
        },
        {
          "command": "datsumi.clearHistory",
          "when": "view == datsumi.history",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "datsumi.newQuery",
          "when": "view == datsumi.connections && viewItem =~ /^(connection(\\.sqlite)?|table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "datsumi.selectConnection",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@1"
        },
        {
          "command": "datsumi.openTable",
          "when": "view == datsumi.connections && viewItem =~ /^(table|view)$/",
          "group": "navigation@1"
        },
        {
          "command": "datsumi.disconnect",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@2"
        },
        {
          "command": "datsumi.removeConnection",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@3"
        },
        {
          "command": "datsumi.showRelationships",
          "when": "view == datsumi.connections && viewItem =~ /^(connection(\\.sqlite)?|table|view)$/",
          "group": "navigation@2"
        },
        {
          "command": "datsumi.filterObjects",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "navigation@8"
        },
        {
          "command": "datsumi.toggleFavorite",
          "when": "view == datsumi.connections && viewItem =~ /^(table|view|collection)$/",
          "group": "navigation@7"
        },
        {
          "command": "datsumi.showHistory",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "navigation@3"
        },
        {
          "submenu": "datsumi.connectionSettings",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@4"
        },
        {
          "command": "datsumi.copyHistory",
          "when": "view == datsumi.history && viewItem == historyEntry",
          "group": "history"
        },
        {
          "command": "datsumi.favoriteHistory",
          "when": "view == datsumi.history && viewItem == historyEntry",
          "group": "history"
        },
        {
          "command": "datsumi.deleteHistory",
          "when": "view == datsumi.history && viewItem == historyEntry",
          "group": "history"
        },
        {
          "command": "datsumi.backupSqlite",
          "when": "view == datsumi.connections && viewItem == connection.sqlite",
          "group": "datsumi@9"
        },
        {
          "command": "datsumi.editConnection",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@2"
        },
        {
          "command": "datsumi.duplicateConnection",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@2"
        },
        {
          "command": "datsumi.copyDiagnostics",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "connection@2"
        }
      ],
      "editor/title": [
        {
          "command": "datsumi.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "datsumi.formatSql",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "datsumi.stageJsonValue",
          "when": "datsumi.jsonDraftActive",
          "group": "navigation"
        },
        {
          "command": "datsumi.showHistory",
          "when": "editorLangId == sql",
          "group": "navigation@3"
        },
        {
          "command": "datsumi.runQueryNewResult",
          "when": "editorLangId == sql",
          "group": "datsumi@1"
        }
      ],
      "editor/context": [
        {
          "command": "datsumi.runQuery",
          "when": "editorLangId == sql",
          "group": "datsumi@1"
        },
        {
          "command": "datsumi.runQueryNewResult",
          "when": "editorLangId == sql",
          "group": "datsumi@2"
        },
        {
          "command": "datsumi.showHistory",
          "when": "editorLangId == sql",
          "group": "datsumi@4"
        },
        {
          "submenu": "datsumi.sqlTools",
          "when": "editorLangId == sql",
          "group": "datsumi@5"
        }
      ],
      "explorer/context": [],
      "webview/context": [
        {
          "command": "datsumi.renameResult",
          "when": "webviewId == 'datsumi.queryResults' && webviewSection == 'resultTab'",
          "group": "datsumi@1"
        },
        {
          "command": "datsumi.pinResult",
          "when": "webviewId == 'datsumi.queryResults' && webviewSection == 'resultTab'",
          "group": "datsumi@1"
        },
        {
          "command": "datsumi.closeResult",
          "when": "webviewId == 'datsumi.queryResults' && webviewSection == 'resultTab'",
          "group": "datsumi@2"
        }
      ],
      "commandPalette": [
        {
          "command": "datsumi.openSqlite",
          "when": "false"
        },
        {
          "command": "datsumi.openDuckdb",
          "when": "false"
        },
        {
          "command": "datsumi.openHistory",
          "when": "false"
        },
        {
          "command": "datsumi.copyHistory",
          "when": "false"
        },
        {
          "command": "datsumi.favoriteHistory",
          "when": "false"
        },
        {
          "command": "datsumi.deleteHistory",
          "when": "false"
        }
      ],
      "datsumi.sqlTools": [
        {
          "command": "datsumi.explainQuery",
          "group": "tools@1"
        },
        {
          "command": "datsumi.configureSqlEditor",
          "group": "tools@2"
        }
      ],
      "datsumi.connectionSettings": [
        {
          "command": "datsumi.changeCredentials",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "credentials"
        },
        {
          "command": "datsumi.forgetCredentials",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "credentials"
        },
        {
          "command": "datsumi.setEnvironment",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "navigation@8"
        },
        {
          "command": "datsumi.toggleHistory",
          "when": "view == datsumi.connections && viewItem =~ /^connection(\\.sqlite)?$/",
          "group": "navigation@9"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "datsumi.connections",
        "contents": "Every database. One workspace.\n[Add Database Connection](command:datsumi.addConnection)\n[Getting Started](command:datsumi.gettingStarted)\n[Help and Privacy](command:datsumi.help)"
      }
    ],
    "keybindings": [
      {
        "command": "datsumi.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == sql || datsumi.queryEditorActive)"
      },
      {
        "command": "datsumi.quickOpen",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "datsumi.runQueryNewResult",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && (editorLangId == sql || datsumi.queryEditorActive)"
      },
      {
        "command": "datsumi.formatSql",
        "key": "shift+alt+f",
        "linux": "ctrl+shift+i",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": [
      {
        "title": "Datsumi: Results",
        "order": 0,
        "properties": {
          "datsumi.results.reuseTabs": {
            "type": "boolean",
            "default": true,
            "description": "Reuse the active unpinned result tab when running another query on the same connection. Pinned results are preserved. Run Query in New Result always creates a separate tab."
          },
          "datsumi.results.defaultPageSize": {
            "type": "integer",
            "default": 100,
            "markdownDescription": "Rows shown on new table/result pages. Saved per-table page sizes take precedence. Copy all still includes the entire available result.",
            "minimum": 25,
            "maximum": 500
          },
          "datsumi.results.density": {
            "type": "string",
            "default": "comfortable",
            "markdownDescription": "Spacing of result grid cells. Uses VS Code fonts and theme colors.",
            "enum": [
              "comfortable",
              "compact"
            ]
          },
          "datsumi.results.showDataTypes": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show database types below column names. Types are never included in copied data."
          },
          "datsumi.results.nullDisplay": {
            "type": "string",
            "default": "NULL",
            "markdownDescription": "Label for SQL NULL cells. Display only; copied NULL values remain empty fields.",
            "maxLength": 24
          }
        }
      },
      {
        "title": "Datsumi: SQL Editor",
        "order": 1,
        "properties": {
          "datsumi.sql.format.keywordCase": {
            "type": "string",
            "default": "upper",
            "markdownDescription": "Letter case for SQL keywords when formatting.",
            "enum": [
              "upper",
              "lower",
              "preserve"
            ]
          },
          "datsumi.sql.format.linesBetweenQueries": {
            "type": "integer",
            "default": 1,
            "markdownDescription": "Blank lines between formatted statements.",
            "minimum": 0,
            "maximum": 3
          },
          "datsumi.sql.completion.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable Datsumi SQL keywords and schema completion. Other extensions may still provide suggestions."
          }
        }
      },
      {
        "title": "Datsumi: History & Privacy",
        "order": 2,
        "properties": {
          "datsumi.history.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Store executed query text locally in this workspace. Text may contain sensitive values; history can expire and is bounded by count and size settings. Use Clear Query History to delete it."
          },
          "datsumi.history.limit": {
            "type": "number",
            "default": 200,
            "minimum": 10,
            "maximum": 2000,
            "description": "Number of recent executed statements to retain locally (favorites are retained separately)."
          },
          "datsumi.history.disabledConnections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Connection IDs for which SQL/query history is disabled."
          },
          "datsumi.history.retentionDays": {
            "type": "integer",
            "default": 30,
            "markdownDescription": "Automatically remove history older than this many days, including favorites. Use 0 to keep entries until count/size limits or manual deletion.",
            "minimum": 0,
            "maximum": 3650
          },
          "datsumi.history.maxStorageMiB": {
            "type": "integer",
            "default": 5,
            "markdownDescription": "Maximum serialized workspace history size, including favorites. Old entries are pruned to stay within this budget.",
            "minimum": 1,
            "maximum": 25
          },
          "datsumi.history.recordProduction": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Record queries from connections labeled production. History contains unencrypted query text and errors; enable only intentionally.",
            "scope": "application"
          },
          "datsumi.drafts.recoveryEnabled": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Keep pending SQL table edits locally for optional recovery after closing/reloading. Values may be sensitive and are not encrypted. Recovery never executes writes automatically.",
            "scope": "application"
          },
          "datsumi.drafts.retentionDays": {
            "type": "integer",
            "default": 7,
            "markdownDescription": "Delete stored edit drafts older than this many days.",
            "minimum": 1,
            "maximum": 30
          }
        }
      },
      {
        "title": "Datsumi: Connections",
        "order": 3,
        "properties": {
          "datsumi.connections.defaultCredentialMode": {
            "type": "string",
            "default": "session",
            "markdownDescription": "Initial credential storage choice in new connection forms. Saved credentials use VS Code SecretStorage; copied/edited profiles never inherit secrets.",
            "enum": [
              "session",
              "ask",
              "save"
            ],
            "scope": "application"
          }
        }
      },
      {
        "title": "Datsumi: Export",
        "order": 4,
        "properties": {
          "datsumi.export.spreadsheetSafe": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Neutralize formula-like text in CSV exports by prefixing an apostrophe. Exact grid copy and JSON remain unchanged."
          }
        }
      },
      {
        "title": "Datsumi: Advanced",
        "order": 5,
        "properties": {
          "datsumi.drivers.downloadBaseUrl": {
            "type": "string",
            "default": "",
            "scope": "application",
            "markdownDescription": "HTTPS release directory for optional driver artifacts matching this extension’s pinned catalog. Set in User Settings; workspace overrides are ignored. Leave empty to install driver files offline."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[sql]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.suggest.showKeywords": true,
        "editor.suggest.showClasses": true,
        "editor.suggest.showFields": true,
        "editor.suggest.showInterfaces": true,
        "editor.tabCompletion": "on"
      }
    },
    "submenus": [
      {
        "id": "datsumi.sqlTools",
        "label": "Database Tools"
      },
      {
        "id": "datsumi.connectionSettings",
        "label": "Connection Settings"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Datsumi",
        "description": "Connect, query, copy and safely review changes in your editor.",
        "steps": [
          {
            "id": "connect",
            "title": "Add a database connection",
            "description": "Use the single **+** in the Connections sidebar. Choose a database, test the connection, and decide whether credentials stay in this session or use secure storage.\n[Add Connection](command:datsumi.addConnection)",
            "completionEvents": [
              "onCommand:datsumi.addConnection"
            ]
          },
          {
            "id": "query",
            "title": "Write and run a query",
            "description": "Select your connection and open a native query editor. Use **Ctrl/Cmd+Enter** to run it. Results appear in the bottom Query Results panel.\n[New Query](command:datsumi.newQuery)",
            "completionEvents": [
              "onCommand:datsumi.runQuery"
            ]
          },
          {
            "id": "copy",
            "title": "Copy clean data into a spreadsheet",
            "description": "Focus the results grid. **Ctrl/Cmd+A**, then **Ctrl/Cmd+C** copies all available data across pages. Add **Shift** when selecting to include column names. Types and statistics stay out of the clipboard. Large results have explicit memory limits.\n[Read the guide](command:datsumi.help)"
          },
          {
            "id": "edit",
            "title": "Review edits before committing",
            "description": "Open a keyed table, edit cells, choose **Review SQL**, then **Commit changes** and confirm. Nothing is written while staging. Read-only reasons appear beside the grid. If a commit outcome is unknown, disconnect and inspect fresh rows before trying again.\n[Help and Privacy](command:datsumi.help)"
          },
          {
            "id": "customize",
            "title": "Choose your editor and privacy settings",
            "description": "Keep your existing SQL formatter or explicitly choose Datsumi. History is local and unencrypted; persisted draft recovery is opt-in.\n[SQL Editor Settings](command:datsumi.configureSqlEditor)\n[Help and Privacy](command:datsumi.help)",
            "completionEvents": [
              "onCommand:datsumi.configureSqlEditor"
            ]
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:sql"
  ],
  "extensionKind": [
    "workspace"
  ],
