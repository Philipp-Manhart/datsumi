{
  "name": "datsumi-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Philipp-Manhart/datsumi.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/drivers/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "bun audit --json",
    "benchmark:results": "bun scripts/benchmark-results.mjs",
    "build": "turbo run build",
    "build:drivers": "node packages/drivers/sql/build.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package:extension": "bun run --cwd apps/extension package",
    "platform:check": "bun scripts/platform-audit.mjs",
    "publication:check": "node scripts/publication-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "sample:db": "node samples/create-sample.mjs",
    "sample:duckdb": "node samples/create-duckdb.mjs",
    "sample:mongodb": "node samples/create-nosql.mjs --mongodb",
    "sample:nosql": "node samples/create-nosql.mjs",
    "sample:nosql:stop": "node samples/create-nosql.mjs --stop",
    "sample:redis": "node samples/create-nosql.mjs --redis",
    "sample:wide": "node samples/create-wide-table.mjs",
    "screenshots": "node apps/extension/test/package-run.mjs --screenshots",
    "test": "vitest run",
    "test:all": "bun run check && DATSUMI_TEST_GROUP=core bun run test:drivers:native && DATSUMI_TEST_GROUP=extended bun run test:drivers:native && bun run test:nosql:native && bun run test:clipboard && bun run test:remote:native",
    "test:clipboard": "bun run --cwd apps/extension build && DATSUMI_TEST_CLIPBOARD_ONLY=1 node apps/extension/test/run.mjs",
    "test:drivers": "node packages/drivers/sql/test/run.mjs",
    "test:drivers:native": "DATSUMI_TEST_NATIVE=1 node packages/drivers/sql/test/run.mjs",
    "test:installed": "node apps/extension/test/package-run.mjs",
    "test:integration": "bun run --cwd apps/extension test:integration",
    "test:minimum": "node scripts/test-minimum.mjs",
    "test:nosql": "node packages/drivers/nosql/test/run.mjs",
    "test:nosql:native": "DATSUMI_TEST_NATIVE=1 node packages/drivers/nosql/test/run.mjs",
    "test:remote": "bun run build:drivers && node packages/drivers/sql/test/run-remote.mjs",
    "test:remote:native": "bun run --cwd apps/extension build && DATSUMI_TEST_NATIVE=1 node packages/drivers/sql/test/run-remote.mjs",
    "test:ui": "node apps/extension/test/package-run.mjs --ui",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@azure/identity": "4.14.1",
    "minimatch": "11.0.1"
  },
  "packageManager": "bun@1.4.2"
}
